# Helios Ventilation Unit
HELIOS_HOST=YOUR_HELIOS_IP
HELIOS_PORT=80

# MQTT Broker
MQTT_HOST=YOUR_MQTT_BROKER_IP
MQTT_PORT=1883
MQTT_USER=YOUR_MQTT_USERNAME
MQTT_PASS=YOUR_MQTT_PASSWORD

# Optional: override the device naming shown in Home Assistant
# (useful if the unit reports a model/type id the lookup tables do not cover)
#HELIOS_DEVICE_MODEL=KWL 300 W ET L
#HELIOS_DEVICE_TYPE=A3712

# Polling Interval (seconds)
REPEAT_INTERVAL=60

